# Copy to .env.local (git-ignored) and fill in from Firebase console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# App Check (web): reCAPTCHA Enterprise site key, plus a debug token for local development.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Offline mode: when true, every AI call runs on-device only (Gemini Nano) and the cloud is never used.
EXPO_PUBLIC_ON_DEVICE_ONLY=false

# Optional: cloud model used by Firebase AI Logic.
EXPO_PUBLIC_CLOUD_MODEL=gemini-3.5-flash-lite

# Development only: run the UI against a local canned engine instead of a real model, so the
# build/edit/history flows can be exercised on a machine with no Gemini Nano. Never used in a
# release build. Leave it false (or unset) for real inference.
EXPO_PUBLIC_MOCK_ENGINE=false

# Optional: base URL of the hosted web build (e.g. https://vonmini.web.app). Share links made on
# phones then open in any browser; without it they use the vonmini:// app link.
EXPO_PUBLIC_SHARE_BASE_URL=

# Development only: point Auth and Firestore at the local Firebase emulators (see README).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
